# Optional local listener bind. Keep loopback for local use; 0.0.0.0 is intended only inside Docker.
KEYSCOPE_HOST=127.0.0.1

# No NEAR API credentials, wallet keys, signer, database, AI service, or custom RPC URL are used.
# KEYSCOPE_ACCESS_PASSWORD below protects the web UI; it is not a wallet or signing key.
# Network (mainnet/testnet), account, and optional contract IDs are selected in the UI.
# The application makes fixed-origin, read-only requests to official NEAR RPC endpoints.

# Required when using Compose/Docker, whose server binds to 0.0.0.0.
# Generate a unique secret of at least 32 characters; never commit the filled .env file.
KEYSCOPE_ACCESS_PASSWORD=

# Optional live Playwright acceptance inputs (used only by the e2e service).
# E2E_ACCOUNT must be a real account you control or are authorized to inspect.
# E2E_CONTRACT is optional; use a real deployed contract if the account has no Function-Call receiver.
E2E_NETWORK=mainnet
E2E_ACCOUNT=
E2E_CONTRACT=
